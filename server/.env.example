# Copy this file to .env and adjust if needed.

# Postgres connection — matches docker-compose.yml by default.
DATABASE_URL=postgres://dlm_user:dlm_dev_password@localhost:5432/dlm_db

# Secret used to sign JWTs. Change this to any long random string for real use.
JWT_SECRET=dev-only-change-me-please

# How long a login session (JWT) stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=4000

# Origin the frontend is served from, for CORS. If you open index.html
# directly (file://) or serve it from a different port, update this.
CLIENT_ORIGIN=http://localhost:5500
